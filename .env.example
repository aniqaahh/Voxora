# ============================================================
# Voxora Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to git.
#
# The .env file is already in .gitignore and will not be deployed
# to GitHub Pages. These variables are only used by the local
# Node.js server (server.js) for server-side API calls.
# ============================================================

# Google Gemini API Key
# Get your API key from: https://aistudio.google.com/apikey
# This key is used server-side ONLY and is never exposed to the browser.
GEMINI_API_KEY=

# Gemini Model ID (optional)
# Default: gemini-3.5-flash-lite (Stable, recommended for new projects)
#
# Available stable text-generation Flash models (Oct 2026):
#   gemini-3.5-flash-lite — fastest, most cost-effective (current default)
#   gemini-3.8-flash      — newest, most intelligent Flash model
#   gemini-3.6-flash      — previous-gen Flash, balanced
#
# Note: gemini-2.0-flash has been shut down.
# Note: gemini-3.5-flash does not exist — only gemini-3.5-flash-lite.
#
# If the default model doesn't work with your API key, try another.
GEMINI_MODEL=gemini-3.5-flash-lite
